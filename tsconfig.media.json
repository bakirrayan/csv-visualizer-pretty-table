{
  "//": "Type-checks the webview JavaScript in media/ without emitting anything.",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "types": []
  },
  "include": ["media/**/*.js", "media/**/*.d.ts"]
}
